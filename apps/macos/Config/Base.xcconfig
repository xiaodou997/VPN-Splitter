// SPDX-License-Identifier: MIT
MACOSX_DEPLOYMENT_TARGET = 26.0
SDKROOT = macosx
SUPPORTED_PLATFORMS = macosx
ARCHS = arm64
ONLY_ACTIVE_ARCH = NO
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
ENABLE_HARDENED_RUNTIME = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES
GENERATE_INFOPLIST_FILE = NO
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1
VPN_APP_BUNDLE_ID = io.github.xiaodou997.VPNSplitter
VPN_EXTENSION_BUNDLE_ID = $(VPN_APP_BUNDLE_ID).PacketTunnel
// Dedicated XPC naming group; never used for credential storage.
VPN_MANAGED_APP_GROUP = $(TeamIdentifierPrefix)$(VPN_APP_BUNDLE_ID).managed
VPN_MANAGED_MACH_SERVICE = $(VPN_MANAGED_APP_GROUP).credentials
VPN_DEVELOPMENT_TEAM =
DEVELOPMENT_TEAM = $(VPN_DEVELOPMENT_TEAM)
VPN_APP_PROFILE_SPECIFIER =
VPN_EXTENSION_PROFILE_SPECIFIER =
VPN_DEVELOPER_ID_IDENTITY = Developer ID Application
#include? "Signing.local.xcconfig"
